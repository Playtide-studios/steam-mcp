{
  "name": "@playtide-studios/steam-mcp",
  "mcpName": "io.github.Playtide-studios/steam-mcp",
  "version": "0.2.7",
  "description": "Steam market intelligence MCP server for game developers: app search, trends, reviews, news.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/fallback-manifest.json','dist/fallback-manifest.json')\"",
    "start": "node src/index.ts",
    "start:dist": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "start:http": "node src/http.ts",
    "test": "node --test test/"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "typescript": "^5.9.3"
  },
  "bin": {
    "steam-mcp": "src/index.ts"
  },
  "files": [
    "src",
    "docs",
    "keys"
  ],
  "prepublishOnly": "npm run typecheck",
  "repository": {
    "type": "git",
    "url": "https://github.com/Playtide-studios/steam-mcp.git"
  },
  "homepage": "https://github.com/Playtide-studios/steam-mcp#readme",
  "bugs": "https://github.com/Playtide-studios/steam-mcp/issues",
  "keywords": [
    "steam",
    "mcp",
    "model-context-protocol",
    "game-development",
    "market-data"
  ],
  "engines": {
    "node": ">=26"
  }
}
